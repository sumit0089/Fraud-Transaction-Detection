# Backend: set these directly in your shell / Render dashboard.
# This example is not automatically loaded by the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120
# Optional educational chat. Backend only; never use a VITE_ prefix for this key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Rolling 24-hour upstream-call cap per process; resets on restart.
CHAT_DAILY_LIMIT=100
# Optional absolute directory; default is backend/artifacts relative to the source.
# MODEL_DIR=/absolute/path/to/backend/artifacts
# Frontend: copy this variable into frontend/.env.local or the Vercel dashboard.
VITE_API_BASE_URL=http://127.0.0.1:8000
